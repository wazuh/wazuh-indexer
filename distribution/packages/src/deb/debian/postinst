#!/bin/bash

# Copyright Wazuh Indexer Contributors
# SPDX-License-Identifier: Apache-2.0
#
# The Wazuh Indexer Contributors require contributions made to
# this file be licensed under the Apache-2.0 license or a
# compatible open source license.

# deb wazuh-indexer postinst script

set -e

# dpkg is not atomic: when an earlier step (e.g. the preinst version block) aborts an
# upgrade, dpkg still invokes this postinst with an abort-* action.
case "$1" in
    abort-upgrade|abort-remove|abort-deconfigure)
        exit 0
        ;;
esac

echo "Running Wazuh Indexer Post-Installation Script"

name="wazuh-indexer"
product_dir=/usr/share/${name}
config_dir=/etc/${name}
data_dir=/var/lib/${name}
log_dir=/var/log/${name}
pid_dir=/run/${name}
defaults_file=/etc/default/${name}
state_file=${config_dir}/.was_active

# Create tmp directory for snapshot operations (avoids filling /tmp)
tmp_dir=${data_dir}/tmp
if [ -L ${tmp_dir} ]; then
    rm -f ${tmp_dir}
fi
mkdir -p ${tmp_dir}

# Set owner
#
# The product tree stays root-owned. Root runs bin/resolve-credentials.sh from
# this script and from the unit's ExecStartPre, and that script sources
# lib/wazuh-indexer-credentials.sh. Group ${name} keeps read and execute -- the
# tree ships 750/640 -- so the service reads everything and writes nothing.
chown -R root:${name} ${product_dir}

# Exceptions: the service genuinely writes these at runtime. Everything else
# under the product tree is read-only to it.
chown -R ${name}:${name} ${product_dir}/engine
if [ -d ${product_dir}/plugins/wazuh-indexer-content-manager/snapshots ]; then
    chown -R ${name}:${name} ${product_dir}/plugins/wazuh-indexer-content-manager/snapshots
fi

# The configuration directory is root's: the service reads it through its group and writes
# nothing in it, so a compromised node cannot rewrite its own configuration, keystore or trust
# material. Regular files and directories only, never through a symbolic link, and chown -h so
# that a link planted where a file is expected is never followed.
#
# own_tree <dir>: <dir> and everything below it, root:${name}, directories 0750, files 0640.
own_tree() {
    local dir="$1" entry
    [ -d "${dir}" ] && [ ! -L "${dir}" ] || return 0
    chown -h root:${name} "${dir}"
    chmod 750 "${dir}"
    for entry in "${dir}"/* "${dir}"/.[!.]* "${dir}"/..?*; do
        [ -e "${entry}" ] || [ -L "${entry}" ] || continue
        [ -L "${entry}" ] && continue
        if [ -d "${entry}" ]; then
            own_tree "${entry}"
        elif [ -f "${entry}" ]; then
            chown -h root:${name} "${entry}"
            chmod 640 "${entry}"
        fi
    done
}

# root_file <path> <mode> [group]: a regular file that is root's alone, or root's and the group's.
root_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 0
    chown -h "root:${3:-root}" "$1"
    chmod "$2" "$1"
}

own_config_dir() {
    local entry
    [ -d "${config_dir}" ] && [ ! -L "${config_dir}" ] || return 0
    chown -h root:${name} "${config_dir}"
    chmod 750 "${config_dir}"
    for entry in "${config_dir}"/* "${config_dir}"/.[!.]* "${config_dir}"/..?*; do
        [ -e "${entry}" ] || [ -L "${entry}" ] || continue
        [ -L "${entry}" ] && continue
        case "${entry##*/}" in
            export)
                # What this package publishes: the directory can be entered by the service
                # group, the passwords are root's alone, the CA certificate is the group's to
                # read.
                [ -d "${entry}" ] || continue
                chown -h root:${name} "${entry}"
                chmod 750 "${entry}"
                root_file "${entry}/credentials.env" 600
                root_file "${entry}/ca.pem" 640 ${name}
                for pair in manager-client dashboard-client; do
                    root_file "${entry}/${pair}.pem" 600
                    root_file "${entry}/${pair}-key.pem" 600
                done
                ;;
            ca)
                # This package's CA, or one staged by the operator: the key is root's alone.
                [ -d "${entry}" ] || continue
                chown -h root:${name} "${entry}"
                chmod 750 "${entry}"
                root_file "${entry}/root-ca.pem" 640 ${name}
                root_file "${entry}/root-ca.key" 400
                root_file "${entry}/.wazuh-indexer-bootstrap-ca" 600
                ;;
            local.env|.wazuh-indexer-keystore)
                # The operator's values, never written by the package, and the record of the
                # keystore the package created: root's alone.
                root_file "${entry}" 600
                ;;
            certs)
                # The node's pair and the CA it trusts are read by the service through its
                # group. The admin pair is root's alone: indexer-security-init.sh runs
                # securityadmin as root, and the service must not be able to act as the
                # security administrator.
                own_tree "${entry}"
                root_file "${entry}/admin.pem" 600
                root_file "${entry}/admin-key.pem" 600
                ;;
            *)
                if [ -d "${entry}" ]; then
                    own_tree "${entry}"
                elif [ -f "${entry}" ]; then
                    chown -h root:${name} "${entry}"
                    chmod 640 "${entry}"
                fi
                ;;
        esac
    done
}

own_config_dir

chown -R ${name}:${name} ${log_dir}
chown -R ${name}:${name} ${data_dir}
mkdir -p ${pid_dir}
chown -R ${name}:${name} ${pid_dir}

# A purge leaves these directories closed to everyone but root, and a fresh
# install over what it kept opens them again with their packaged mode. An
# upgrade leaves the operator's modes alone.
if [ -z "$2" ]; then
    chmod 750 ${config_dir} ${product_dir} ${data_dir} ${log_dir}
fi

# systemd reads the EnvironmentFile as root, so a service-writable copy lets the
# service account set variables for the root pre-start step. It carries no
# secret, so group read is enough.
chown root:${name} ${defaults_file}
chmod 0640 ${defaults_file}


# Change permissions for Wazuh Engine
ENGINE_DIR="${product_dir}/engine"

if [ -d "$ENGINE_DIR" ]; then
    find "$ENGINE_DIR" -type d -exec chmod 750 {} +
    find "$ENGINE_DIR" -type f -exec chmod 640 {} +

    # Set executable permissions
    [ -f "$ENGINE_DIR/run_engine.sh" ] && chmod 750 "$ENGINE_DIR/run_engine.sh"
    [ -f "$ENGINE_DIR/bin/wazuh-engine" ] && chmod 750 "$ENGINE_DIR/bin/wazuh-engine"

    # Set sockets directory permissions
    [ -d "$ENGINE_DIR/sockets" ] && [ ! -L "$ENGINE_DIR/sockets" ] && chmod 750 "$ENGINE_DIR/sockets"
fi

# Reload systemctl daemon
if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
    systemctl daemon-reload > /dev/null 2>&1
fi

# Reload other configs
if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
    systemctl restart systemd-sysctl.service || true
fi

if command -v systemd-tmpfiles > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
    systemd-tmpfiles --create ${name}.conf > /dev/null 2>&1
fi

# Check if the script is executed on upgrade
if [ -n "$2" ]; then
    if [ -f ${state_file}  ]; then
        echo "Restarting ${name}.service because it was active before upgrade"
        rm -f ${state_file}
        if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
            systemctl restart ${name}.service > /dev/null 2>&1
        elif command -v service > /dev/null 2>&1; then
            service ${name} restart > /dev/null 2>&1
        elif command -v /etc/init.d/${name} > /dev/null 2>&1; then
            /etc/init.d/${name} restart > /dev/null 2>&1
        fi
    else
        echo "### NOT restarting ${name} service after upgrade"
        echo "### You can start ${name} service by executing"
        if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
            echo " sudo systemctl start ${name}.service"
        elif command -v service > /dev/null 2>&1; then
            echo " sudo service ${name} start"
        elif command -v /etc/init.d/${name} > /dev/null 2>&1; then
            echo " sudo /etc/init.d/${name} start"
        fi
    fi
fi

# Resolve credentials and TLS material. Quiet, so the next steps below are the last thing printed;
# anything that could not be resolved still shows.
if [ -x "${product_dir}/bin/resolve-credentials.sh" ]; then
    if [ -n "$2" ]; then
        "${product_dir}/bin/resolve-credentials.sh" --upgrade --quiet || true
    else
        "${product_dir}/bin/resolve-credentials.sh" --install --quiet || true
    fi
fi

# The node creates opensearch.keystore at its first start when it is absent, and rewrites it
# when its format is older than the one it knows. The configuration directory is root's now,
# so both happen here, as root, and the node never has to write there. After the resolver: the
# keystore tool loads opensearch.yml and refuses it while the DN settings the resolver fills
# are empty, so on a node whose certificates could not be issued yet the pre-start step creates
# the keystore once they are. A keystore the operator protected with a password is left alone:
# the upgrade would prompt for it.
keystore="${config_dir}/opensearch.keystore"
if [ ! -e "${keystore}" ] && [ ! -L "${keystore}" ]; then
    if OPENSEARCH_PATH_CONF="${config_dir}" "${product_dir}/bin/opensearch-keystore" create < /dev/null > /dev/null; then
        # What the package created, so that a purge can tell it from one the operator put
        # secrets in: the digest of the keystore as created.
        sha256sum < "${keystore}" > "${config_dir}/.wazuh-indexer-keystore"
        chmod 600 "${config_dir}/.wazuh-indexer-keystore"
    else
        echo "WARNING: could not create ${keystore}; the pre-start step will try again" >&2
    fi
elif [ -f "${keystore}" ] && [ ! -L "${keystore}" ]; then
    OPENSEARCH_PATH_CONF="${config_dir}" "${product_dir}/bin/opensearch-keystore" upgrade < /dev/null > /dev/null \
        || echo "WARNING: could not upgrade ${keystore}" >&2
fi
root_file "${keystore}" 640 ${name}

# What to do next, on a fresh install only.
if [ -z "$2" ]; then
    echo ""
    if [ -f "${config_dir}/export/credentials.env" ]; then
        echo "Passwords saved in ${config_dir}/export/credentials.env (readable by root only)."
        echo "Log in to the Wazuh dashboard as admin, with WAZUH_INDEXER_ADMIN_PASSWORD."
    fi
    # The package already ran `systemctl daemon-reload`, so the only steps left are enabling and
    # starting, which `--now` does together.
    echo "The indexer is not running, and will not start at boot until it is enabled:"
    if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
        echo " systemctl enable --now ${name}"
    elif command -v chkconfig > /dev/null 2>&1; then
        echo " chkconfig --add ${name} && service ${name} start"
    elif command -v update-rc.d > /dev/null 2>&1; then
        echo " update-rc.d ${name} defaults 95 10 && service ${name} start"
    fi
    echo "Then load the security configuration, once, from one node:"
    echo " ${product_dir}/bin/indexer-security-init.sh"
    echo "The package opens no firewall port: 9200 (API) and 9300 (cluster) stay as the host has them."
fi

exit 0
