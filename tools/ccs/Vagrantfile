# Packages are taken from this artifact list. Override it with WAZUH_ARTIFACT_URLS to test another
# build, e.g. a different nightly or a release candidate.
artifact_urls = ENV.fetch(
    "WAZUH_ARTIFACT_URLS",
    "https://packages-staging.xdrsiem.wazuh.info/nightly/5.0.0/artifact-urls/artifact_urls_5.0.0-latest.yaml"
)
memory = ENV.fetch("VM_MEMORY", "4096")
cpus = ENV.fetch("VM_CPUS", "4")

# node-start.sh carries the same addresses and host names.
nodes = [
    { name: "cluster_a", hostname: "cluster-a", ip: "192.168.56.11" },
    { name: "cluster_b", hostname: "cluster-b", ip: "192.168.56.12" },
    { name: "ccs",       hostname: "ccs",       ip: "192.168.56.10" },
]

# Creates the shared root CA and the credentials file before any machine is provisioned.
if (ARGV & %w[up provision reload]).any?
    abort("pre-start.sh failed") unless system("bash", "./pre-start.sh", chdir: __dir__)
end

Vagrant.configure("2") do |config|
    config.vm.box = "almalinux/9"
    # Nothing is shared through /vagrant: the files each node needs are uploaded below, which works
    # the same on every provider.
    config.vm.synced_folder ".", "/vagrant", disabled: true

    config.vm.provider "virtualbox" do |vb|
        vb.memory = memory
        vb.cpus = cpus
    end
    config.vm.provider "libvirt" do |lv|
        lv.memory = memory
        lv.cpus = cpus
    end

    nodes.each do |node|
        config.vm.define node[:name] do |n|
            n.vm.hostname = node[:hostname]
            n.vm.network "private_network", ip: node[:ip]

            %w[ca/root-ca.pem ca/root-ca.key credentials.env].each do |file|
                n.vm.provision "file", source: file, destination: "/tmp/ccs/#{File.basename(file)}"
            end
            n.vm.provision "shell", path: "node-start.sh", args: [node[:name]],
                env: { "ARTIFACT_URLS" => artifact_urls }
        end
    end
end
