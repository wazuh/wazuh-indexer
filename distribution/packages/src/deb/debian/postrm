#!/bin/bash

# Copyright Wazuh Indexer Contributors
# SPDX-License-Identifier: Apache-2.0
#
# The Wazuh Indexer Contributors require contributions made to
# this file be licensed under the Apache-2.0 license or a
# compatible open source license.

# deb wazuh-indexer postrm script

set -e

name="wazuh-indexer"
product_dir=/usr/share/${name}
config_dir=/etc/${name}
data_dir=/var/lib/${name}
log_dir=/var/log/${name}

case "$1" in
    remove|purge)
        rm -rf "${product_dir}/engine"
        rm -rf "${product_dir}/plugins"

        if [ "$1" = "purge" ]; then
            # The certificates this node was issued from its own CA go with it. Kept, they
            # are an identity nothing trusts any more, and a reinstall would find them
            # beside a new CA. Only a CA with its key here issued anything on this host; a
            # pair it did not issue -- the operator's own -- stays, and a reinstall with
            # nothing to verify it against reports it rather than minting a CA beside it.
            ca_dir="${config_dir}/ca"
            certs_dir="${config_dir}/certs"
            if [ -f "${ca_dir}/root-ca.key" ] && [ -f "${ca_dir}/root-ca.pem" ]; then
                for cert in indexer admin; do
                    if [ -f "${certs_dir}/${cert}.pem" ] && [ ! -L "${certs_dir}/${cert}.pem" ] && \
                       openssl verify -no_check_time -CAfile "${ca_dir}/root-ca.pem" \
                           "${certs_dir}/${cert}.pem" > /dev/null 2>&1; then
                        rm -f "${certs_dir:?}/${cert:?}.pem" "${certs_dir:?}/${cert:?}-key.pem"
                    fi
                done
                if [ -f "${certs_dir}/root-ca.pem" ] && [ ! -L "${certs_dir}/root-ca.pem" ] && \
                   [ "$(sha256sum < "${ca_dir}/root-ca.pem")" = "$(sha256sum < "${certs_dir}/root-ca.pem")" ]; then
                    rm -f "${certs_dir:?}/root-ca.pem"
                fi
                rmdir "${certs_dir}" > /dev/null 2>&1 || true
            fi

            # What this package published for the other components on this host, its CA and
            # the record that it resolved its credentials.
            rm -rf "${config_dir:?}/export" "${config_dir:?}/ca"
            rm -f "${data_dir:?}/.initialized"

            # The keystore the package created, when it is still exactly as created: one the
            # operator put secrets in has a different digest and stays, with the marker.
            keystore="${config_dir}/opensearch.keystore"
            keystore_marker="${config_dir}/.wazuh-indexer-keystore"
            if [ -f "${keystore_marker}" ] && [ ! -L "${keystore_marker}" ] \
               && [ -f "${keystore}" ] && [ ! -L "${keystore}" ] \
               && [ "$(sha256sum < "${keystore}")" = "$(cat "${keystore_marker}")" ]; then
                rm -f "${config_dir:?}/opensearch.keystore" "${config_dir:?}/.wazuh-indexer-keystore"
            fi

            # Where releases before this one stashed a helper library.
            rm -f /var/lib/${name}/.wazuh-credentials.sh /etc/wazuh/.${name}-credentials.sh

            # postinst creates the tmp directory, so it is not in the dpkg file
            # list and dpkg would leave it. The package's directories themselves
            # only go if nothing else is left in them: indexed data is never
            # deleted here.
            rm -rf "${data_dir:?}/tmp"
            rmdir "${config_dir}" "${product_dir}" "${data_dir}" "${log_dir}" > /dev/null 2>&1 || true

            # The purge manages the package's own directories and nothing else.
            # Hand every file the service account owns in them over to root
            # before the account goes: userdel frees the UID, and the next
            # system account created would inherit it -- and with it any
            # certificates, the keystore, the logs and the indexed data left
            # behind. The files keep their modes. Each directory is closed to
            # everyone but root instead, which keeps what is inside unreadable
            # and is all a reinstall has to undo; postinst does, beside the
            # chown -R it already runs. Nothing is deleted. find -H follows a
            # directory that is itself a symlink but no link inside it, and
            # chown -h changes those links themselves, so a link the account
            # planted cannot aim any of this at another file.
            #
            # dpkg removes the package's own empty directories only after this
            # script, so a directory that holds nothing but directories is not
            # reported as kept: it is about to go.
            not_handed_over=""
            if getent passwd ${name} > /dev/null 2>&1; then
                for dir in "${config_dir}" "${product_dir}" "${data_dir}" "${log_dir}"; do
                    [ -d "${dir}" ] || continue
                    dir_ok=true
                    find -H "${dir}" \( -user ${name} -exec chown -h root:root {} + \) \
                        -o \( -group ${name} -exec chgrp -h root {} + \) 2>/dev/null || dir_ok=false
                    chmod go-rwx "${dir}" 2>/dev/null || dir_ok=false
                    if [ "${dir_ok}" != true ]; then
                        not_handed_over="${not_handed_over} ${dir}"
                    elif [ -n "$(find -H "${dir}" -mindepth 1 ! -type d -print -quit 2>/dev/null)" ]; then
                        echo "Kept ${dir}, now owned by root. Reinstalling ${name} takes it back."
                    fi
                done
            fi
            if [ -n "${not_handed_over}" ]; then
                echo "Some files under${not_handed_over} could not be handed over to root; they keep the ID of the removed ${name} user." >&2
            fi

            # preinst creates the service account, and a purge always takes it
            # back. userdel may already have dropped the group along with the
            # user (USERGROUPS_ENAB), hence the second lookup.
            #
            # A JVM keeps its performance data in /tmp/hsperfdata_<user>. A node
            # the SysV script starts runs outside the unit's private /tmp, so
            # that directory is left behind. It is empty once the JVM exits, but
            # the next account given the freed ID would own it.
            if getent passwd ${name} > /dev/null 2>&1; then
                find /tmp -maxdepth 1 -type d -name "hsperfdata_${name}" -user ${name} \
                    -exec rm -rf {} + 2>/dev/null || true
                userdel ${name} > /dev/null 2>&1 || true
            fi
            if getent group ${name} > /dev/null 2>&1; then
                groupdel ${name} > /dev/null 2>&1 || true
            fi

            echo "Note: the package only manages ${config_dir}, ${product_dir}, ${data_dir} and ${log_dir}."
            echo "Directories set elsewhere in opensearch.yml (a custom path.data, path.logs or path.repo) are left as they are, still owned by the ID of the removed ${name} user."
        fi

        # Make systemd forget the unit, now that its file is gone
        if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
            systemctl daemon-reload > /dev/null 2>&1 || true
        fi

        # On purge the SysV init script goes away too, so drop the runlevel
        # links it left in /etc/rc?.d, which would otherwise dangle. Neither
        # `systemctl enable` nor `disable` removes them: both delegate to
        # update-rc.d, which only flips S links into K links. `remove` is the
        # only subcommand that deletes them, and it needs -f because by now the
        # init script is already gone.
        if [ "$1" = "purge" ] && command -v update-rc.d > /dev/null 2>&1; then
            update-rc.d -f ${name} remove > /dev/null 2>&1 || true
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
